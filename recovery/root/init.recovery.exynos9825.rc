on init
    export ANDROID_ROOT /system_root
    write /proc/sys/kernel/hung_task_timeout_secs 0
    # Samsung enables the torch with 1; OrangeFox defaults to 1 without max_brightness.
    mkdir /dev/fox_flashlight 0755 root root
    symlink /sys/class/camera/flash/rear_flash /dev/fox_flashlight/brightness

on boot
    setprop ro.boot.vbmeta.avb_version 1.1
    setprop ro.boot.avb_version 1.1

on property:sys.usb.ffs.ready=1
    start nuker

service nuker /system/bin/sh /sbin/nuker.sh
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0
